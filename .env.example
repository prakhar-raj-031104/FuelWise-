# Copy to .env and adjust as needed: cp .env.example .env

# Ollama model to pull and use.
#   llama3.2    -> ~3B, accurate complete answers, ~5-7s on CPU (recommended)
#   llama3.2:1b -> faster on weak hardware, but more rambling/less accurate
OLLAMA_MODEL=llama3.2

# Answer length cap (safety net) and sampling temperature.
# num_predict is set high so answers finish naturally instead of truncating;
# the prompt keeps them short. Lower temperature = more factual/deterministic.
OLLAMA_NUM_PREDICT=300
OLLAMA_TEMPERATURE=0.3

# Host port the web app is served on (maps to the frontend container's :80).
FRONTEND_PORT=80

# Allowed CORS origins for the backend (comma-separated). Should match the URL
# you open the app from. Defaults cover http://localhost and the frontend port.
CORS_ORIGINS=http://localhost,http://localhost:80
